{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build:android": "tsc -b && vite build --config vite.android.config.ts --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "android:apk": "node scripts/build-android.mjs",
    "android:usb": "node scripts/android-usb.mjs",
    "android:apk:live": "node scripts/build-android.mjs --live",
    "android:live": "node scripts/android-usb.mjs --live --launch --watch",
    "android:live:install": "npm run android:apk:live && node scripts/android-usb.mjs --live --install --launch",
    "build:ios": "tsc -b && vite build --config vite.ios.config.ts --mode ios",
    "ios:sync": "node scripts/ios.mjs sync",
    "ios:simulator:build": "node scripts/ios.mjs build",
    "ios:simulator:run": "node scripts/ios.mjs run"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "jsbarcode": "3.12.3",
    "konva": "10.9.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "19.3.2",
    "recharts": "3.10.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@zxing/library": "0.23.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.65.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
